<html>
 <head>
  <meta charset='utf-8' />
  <meta http-equiv='X-UA-Compatible' content='IE=edge' />
  <link rel='icon' href='./icon.svg' sizes='any' type='image/svg+xml' />
  <title>Page Title</title>
  <meta name='viewport' content='width=device-width, initial-scale=1' />
  <script> var name = name.name</script>
 </head>
 <body>
  <h1>Your Business Card</h1>
  <p id='ppp' style='font-size: 24px;'>Hi {{name}}, your card is printing...</p>
  <script>
   let delay = 10; let time = 1; const ppp = document.getElementById('ppp');
   const interval = setInterval(() => { if (time <= delay) { ppp.innerHTML = `Hi
   {{name}}, your card is printing in ` + (delay - time) + ' seconds.'; time++;
   } else { ppp.innerHTML = `Hi
   {{name}}, here is your card <br> <ul> <li><a href="{{pdf}}" target="_blank">{{pdf}}</a></li>
   <li><a href="{{bas}}.txt" target="_blank">{{bas}}.txt</a></li> </ul> `;
   clearInterval(interval); } }, 1000);
  </script>
 </body>
</html>